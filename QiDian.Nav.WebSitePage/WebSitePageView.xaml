<UserControl x:Class="QiDian.Nav.WebSitePage.WebSitePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QiDian.Nav.WebSitePage"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 细滚动条样式：作用于本页内 ListBox 与抽屉的所有滚动条 -->
                <ResourceDictionary Source="ScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== 新增网站弹窗用的小型控件样式 ===== -->

            <!-- 字段标签 -->
            <Style x:Key="AddDialogLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- 输入框（与抽屉内只读网址框同款观感） -->
            <Style x:Key="AddDialogInput" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Style>

            <!-- 主按钮（粉/主题色实底） -->
            <Style x:Key="AddPrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 次按钮（透明底 + 描边） -->
            <Style x:Key="AddGhostButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 右上角关闭 ✕ -->
            <Style x:Key="AddCloseButton" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid ClipToBounds="True">

        <!-- ============ 主内容：标题 + 左侧垂直网站列表 ============ -->
        <Grid Margin="24,24,16,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题区 -->
            <DockPanel Grid.Row="0" Margin="2,0,2,18">
                <Border Width="4" Height="20" Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="2" VerticalAlignment="Center"/>
                <TextBlock Text="网站精选" Margin="10,0,0,0"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="新增网站"
                           FontSize="12"
                           Foreground="{DynamicResource PinkBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Command="{Binding AddWebSiteItem}"/>
            </DockPanel>

            <!-- 网站列表（竖排：每行左侧显示网站名 + 链接） -->
            <ListBox Grid.Row="1"
                     x:Name="SiteList"
                     ItemsSource="{Binding Sites}"
                     SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                     PreviewMouseLeftButtonUp="SiteList_PreviewMouseLeftButtonUp"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Margin="0,2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- 每行：左侧 图标+网站名 / 链接 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Url}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ============ 右侧抽屉（覆盖式，从右边界向左滑入） ============ -->
        <Border x:Name="DrawerHost"
                HorizontalAlignment="Right"
                Width="340"
                Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerSlide" X="340"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="8" Direction="180"
                                  Opacity="0.28" Color="#000000"/>
            </Border.Effect>
            <local:WebSiteDetailView x:Name="DetailView"
                                     ViewModel="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CloseRequested="DetailView_CloseRequested"/>
        </Border>

        <!-- ============ 新增网站弹窗（覆盖式模态，置于最上层） ============ -->
        <Grid x:Name="AddSiteLayer"
              Visibility="Collapsed"
              Opacity="0"
              Focusable="True"
              KeyDown="AddSiteLayer_KeyDown"
              Background="Transparent">
            <!-- 半透明遮罩，挡住下层交互 -->
            <Rectangle Fill="#66000000"/>

            <!-- 居中卡片 -->
            <Border Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,18,24,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270"
                                      Opacity="0.35" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- 标题行 -->
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="✕" FontSize="14"
                                Style="{StaticResource AddCloseButton}"
                                Command="{Binding CancelAddCommand}"/>
                        <TextBlock Text="新增网站" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 名称 -->
                    <TextBlock Text="名称（必填）" Style="{StaticResource AddDialogLabel}"/>
                    <TextBox x:Name="NewNameBox"
                             Style="{StaticResource AddDialogInput}"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 网址 -->
                    <TextBlock Text="网址（必填）" Style="{StaticResource AddDialogLabel}" Margin="0,14,0,6"/>
                    <TextBox Style="{StaticResource AddDialogInput}"
                             Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 简介 -->
                    <TextBlock Text="简介（可选）" Style="{StaticResource AddDialogLabel}" Margin="0,14,0,6"/>
                    <TextBox Style="{StaticResource AddDialogInput}"
                             Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="72" MaxHeight="160"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- 图标 -->
                    <TextBlock Text="图标（可选，填 emoji 如 🌐 或 🎬）" Style="{StaticResource AddDialogLabel}" Margin="0,14,0,6"/>
                    <TextBox Style="{StaticResource AddDialogInput}"
                             Text="{Binding NewIcon, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- 底部按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="取消"
                                Style="{StaticResource AddGhostButton}"
                                Padding="20,9"
                                Margin="0,0,10,0"
                                Command="{Binding CancelAddCommand}"/>
                        <Button Content="新增"
                                Style="{StaticResource AddPrimaryButton}"
                                Background="{DynamicResource PinkBrush}"
                                Padding="28,9"
                                Command="{Binding ConfirmAddCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
