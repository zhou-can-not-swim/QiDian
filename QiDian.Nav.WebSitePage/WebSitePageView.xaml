<UserControl x:Class="QiDian.Nav.WebSitePage.WebSitePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QiDian.Nav.WebSitePage"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 细滚动条样式：作用于本页内 ListBox 与抽屉的所有滚动条 -->
                <ResourceDictionary Source="ScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
        
    </UserControl.Resources>

    <Grid ClipToBounds="True">

        <!-- ============ 主内容：标题 + 左侧垂直网站列表 ============ -->
        <Grid Margin="24,24,16,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题区 -->
            <DockPanel Grid.Row="0" Margin="2,0,2,18">
                <Border Width="4" Height="20" Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="2" VerticalAlignment="Center"/>
                <TextBlock Text="网站精选" Margin="10,0,0,0"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="新增网站"
                           FontSize="12"
                           Foreground="{DynamicResource PinkBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Command="{Binding AddWebSiteItem}"/>
            </DockPanel>

            <!-- 网站列表（竖排：每行左侧显示网站名 + 链接） -->
            <ListBox Grid.Row="1"
                     x:Name="SiteList"
                     ItemsSource="{Binding Sites}"
                     SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                     PreviewMouseLeftButtonUp="SiteList_PreviewMouseLeftButtonUp"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Margin="0,2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- 每行：左侧 图标+网站名 / 链接 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Url}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ============ 右侧抽屉（覆盖式，从右边界向左滑入） ============ -->
        <Border x:Name="DrawerHost"
                HorizontalAlignment="Right"
                Width="340"
                Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerSlide" X="340"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="8" Direction="180"
                                  Opacity="0.28" Color="#000000"/>
            </Border.Effect>
            <local:WebSiteDetailView x:Name="DetailView"
                                     ViewModel="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     CloseRequested="DetailView_CloseRequested"/>
        </Border>
    </Grid>
</UserControl>
