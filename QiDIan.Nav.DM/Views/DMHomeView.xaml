<UserControl x:Class="QiDian.Nav.DM.Views.DMHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DMCards.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部搜索栏：整条可点击，进入搜索页 ===== -->
        <Button Grid.Row="0" Click="SearchBar_Click" Cursor="Hand"
                Background="Transparent" BorderThickness="0" Padding="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,11">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" FontSize="16"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SearchPlaceholder}" Margin="10,0"
                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="2" Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="6" Padding="12,5">
                    <TextBlock Text="搜索" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Button>

        <!-- ===== 栏目区（可动态添加，每个栏目横向滑动卡片） ===== -->
        <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,24">
                            <!-- 栏目标题 -->
                            <DockPanel Margin="2,0,2,12">
                                <Border Width="4" Height="18" Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="2" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- 栏目内卡片：横向一排，可左右滑动 -->
                            <ScrollViewer PreviewMouseWheel="HorizontalScroll_MouseWheel"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly">
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource AnimeCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
