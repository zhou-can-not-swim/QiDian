<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dm="clr-namespace:QiDian.Nav.DM.Converter">

    <dm:UrlToImageConverter x:Key="UrlToImage"/>
    <dm:TitleFirstCharConverter x:Key="TitleFirstChar"/>

    <!-- ===== 番剧卡片模板（首页栏目 / 搜索结果显示共用） =====
         Command 向上绑定到所在页面（UserControl）的 ViewModel.OpenAnimeCommand，
         CommandParameter 即当前 AnimeItem。 -->
    <DataTemplate x:Key="AnimeCardTemplate">
        <Button Cursor="Hand" Padding="0"
                Background="Transparent" BorderThickness="0"
                Command="{Binding DataContext.OpenAnimeCommand,
                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <StackPanel Width="152">
                <!-- 封面 -->
                <Border Width="152" Height="203" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <!-- 占位：封面未加载时显示标题首字 -->
                        <TextBlock Text="{Binding Title, Converter={StaticResource TitleFirstChar}}"
                                   FontSize="40" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Cover, Converter={StaticResource UrlToImage}}"
                               Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <!-- 标题（最多两行） -->
                <TextBlock Text="{Binding Title}" Margin="2,8,2,0"
                           FontSize="13" FontWeight="SemiBold" MaxHeight="38"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Left"/>
                <!-- 更新信息 -->
                <TextBlock Text="{Binding UpdateInfo}" Margin="2,3,2,0"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
            </StackPanel>
        </Button>
    </DataTemplate>
</ResourceDictionary>
