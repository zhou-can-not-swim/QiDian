<UserControl x:Class="QiDian.Nav.DM.Views.DMDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dm="clr-namespace:QiDian.Nav.DM.Converter">

    <UserControl.Resources>
        <dm:UrlToImageConverter x:Key="UrlToImage"/>
        <dm:TitleFirstCharConverter x:Key="TitleFirstChar"/>
        <dm:CountToVisibilityConverter x:Key="CountToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部：返回 + 标题 ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="Back_Click" Cursor="Hand" Padding="0"
                    Width="40" Height="40" Margin="0,0,14,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="←" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding Anime.Title}"
                       FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- ===== 内容区 ===== -->
        <ScrollViewer Grid.Row="1" Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 封面 + 简介 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 封面 -->
                    <Border Grid.Column="0" Width="176" Height="235" CornerRadius="10"
                            ClipToBounds="True" Background="{DynamicResource CardBackgroundBrush}">
                        <Grid>
                            <TextBlock Text="{Binding Anime.Title, Converter={StaticResource TitleFirstChar}}"
                                       FontSize="52" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Anime.Cover, Converter={StaticResource UrlToImage}}"
                                   Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- 信息 -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                        <!-- 更新信息 / 评分 -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding Anime.UpdateInfo}"
                                           FontSize="12" Foreground="White"/>
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center">
                                <Run Text="评分 "/>
                                <Run Text="{Binding Anime.Score, StringFormat={}{0:0.0}}"
                                     FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </TextBlock>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Episodes.Count, StringFormat=共 {0} 话}"/>
                        </StackPanel>

                        <!-- 简介 -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <TextBlock Text="{Binding Anime.Description, FallbackValue=暂无简介}"
                                       FontSize="13" LineHeight="20"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 选集 -->
                <StackPanel Margin="0,28,0,0">
                    <DockPanel Margin="2,0,2,14">
                        <Border Width="4" Height="18" Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="2" VerticalAlignment="Center"/>
                        <TextBlock Text="选集" Margin="10,0,0,0"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Margin="0,0,4,0"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding Episodes.Count, StringFormat={}{0} 集}"/>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Episodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,10,10" Width="68" Height="36" Cursor="Hand"
                                        Command="{Binding DataContext.PlayEpisodeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="9"
                                                   HorizontalAlignment="Center" Margin="0,-1,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 暂无选集提示 -->
                    <TextBlock Text="暂无选集（接入爬虫后这里会列出全部剧集）"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="4,6,0,0"
                               Visibility="{Binding Episodes.Count, Converter={StaticResource CountToVisibility}}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
