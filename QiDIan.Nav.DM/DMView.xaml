<UserControl x:Class="QiDian.Nav.DM.DMView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dm="clr-namespace:QiDian.Nav.DM.Converter">
    <UserControl.Resources>
        <dm:DMViewToViewConverter x:Key="DmToView"/>
    </UserControl.Resources>

    <!-- 宿主：只负责在内容区里切换内部页面（首页/搜索/详情/播放） -->
    <ContentControl Content="{Binding CurrentPage, Converter={StaticResource DmToView}}"/>
</UserControl>
