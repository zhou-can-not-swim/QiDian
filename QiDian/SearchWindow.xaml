<!-- SearchWindow.xaml -->
<Window x:Class="QiDian.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:QiDian.Converters"
        mc:Ignorable="d"
        Height="500" Width="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Deactivated="SearchWindow_Deactivated">
    <Window.Resources>
        <local:FilePathToIconConverter x:Key="FilePathToIconConverter"/>
        <local:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyVisConv"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 搜索输入框 -->
        <Border Grid.Row="0"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    BorderBrush="#E4E7EB"
                    BorderThickness="1"
                    Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 输入框 -->
                <TextBox x:Name="SearchTextBox"
                            Grid.Column="0"
                            BorderThickness="0"
                            FontSize="16"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
                <!-- 搜索图标 -->
                <Button Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="NavClick">
                    <TextBlock Text="🔍"
                           FontSize="18"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                </Button>
            </Grid>
        </Border>

        <!-- 结果区域 -->
        <Grid Grid.Row="1" Margin="0,1,0,0">
            <!-- 结果列表 -->
            <ListBox x:Name="ResultsListBox"
                     Background="White"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ResultsListBox_SelectionChanged"
                     MouseDoubleClick="ResultsListBox_MouseDoubleClick"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="56"/>
                        <Setter Property="Margin" Value="0,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F2F5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E8F0FE"/>
                            </Trigger>
                        </Style.Triggers>
                        
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标区域 -->
                                <Border Grid.Column="0"
                                    Width="32" Height="32"
                                    CornerRadius="6"
                                    Background="#E8F0FE"
                                    Margin="0,0,12,0">
                                    <Image Source="{Binding FullPath, Converter={StaticResource FilePathToIconConverter}}" Width="24" Height="24"/>
                                </Border>

                                <!-- 标题和描述 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"/>
                                    <TextBlock Text="{Binding FullPath}"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态提示（仅在搜索无结果时显示） -->
            <Border x:Name="EmptyStateBorder"
                    Background="White"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24,20">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔍"
                               FontSize="32"
                               HorizontalAlignment="Center"
                               Opacity="0.3"/>
                    <TextBlock x:Name="EmptyStateText"
                               Text="未找到匹配结果"
                               FontSize="14"
                               Foreground="#9CA3AF"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>