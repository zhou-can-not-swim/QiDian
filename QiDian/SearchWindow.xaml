<!-- SearchWindow.xaml -->
<Window x:Class="QiDian.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:QiDian.Converters"
        mc:Ignorable="d"
        Width="830"
        MaxHeight="840"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Deactivated="SearchWindow_Deactivated">
    <Window.Resources>
        <local:FilePathToIconConverter x:Key="FilePathToIconConverter"/>
        <local:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyVisConv"/>

        <!-- 分组标题栏（可点击折叠/展开，无 hover 背景，保持简洁） -->
        <Style x:Key="SectionHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 折叠箭头：折叠时向右 ▶，展开时向下 ▼ -->
        <Style x:Key="CollapseArrowStyle" TargetType="Path">
            <Setter Property="Data" Value="M 4 0 L 8 4 L 4 8"/>
            <Setter Property="Stroke" Value="#9CA3AF"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RecentItemTemplate">
            <Border Width="76" Padding="4,6"
                    ToolTip="{Binding TruePath}">
                <StackPanel>
                    <Border Width="45" Height="45" CornerRadius="12" Background="#EEF3FA" HorizontalAlignment="Center">
                        <Image Source="{Binding Icon, Converter={StaticResource FilePathToIconConverter}}"
                               Width="30" Height="30"/>
                    </Border>
                    <TextBlock Text="{Binding FileName}"
                               FontSize="11"
                               Foreground="#374151"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="28"
                               MinHeight="28"
                               MaxWidth="60"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                CornerRadius="8,8,0,0"
                BorderBrush="#E4E7EB"
                BorderThickness="1,1,1,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 输入框 -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         BorderThickness="0"
                         FontSize="16"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         PreviewKeyDown="SearchTextBox_PreviewKeyDown"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,0">

            <Border Background="White"
                    CornerRadius="0"
                    BorderBrush="White"
                    BorderThickness="1,0,1,0">
                <StackPanel>
                    <Button Style="{StaticResource SectionHeaderButtonStyle}"
                            Click="RecentHeader_Click"
                            BorderThickness="0">
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="常用软件"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       Grid.Column="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Border Background="#EFF3F7" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RecentTotalCount}"
                                               FontSize="10"
                                               Foreground="#6B7280"/>
                                </Border>
                                <Path Margin="8,0,0,0">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource CollapseArrowStyle}">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="0"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecentExpanded}" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- 内容区-->
                    <Grid>
                        <Border Height="1" Background="#F0F2F5" VerticalAlignment="Top"/>
                        <Grid Margin="0,4,0,0">
                            <!-- 搜索结果 -->
                            <ListBox x:Name="RecentListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseWheel="RecentListBox_PreviewMouseWheel"
                                     SelectionChanged="RecentListBox_SelectionChanged"
                                     MouseDoubleClick="RecentListBox_MouseDoubleClick"
                                     Visibility="{Binding RecentItems, Converter={StaticResource CollectionEmptyVisConv}}">
                                <ListBox.Style>
                                    <Style TargetType="ListBox">
                                        <!-- 折叠 -->
                                        <Setter Property="MinHeight" Value="102"/>
                                        <Setter Property="MaxHeight" Value="120"/>
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecentExpanded}" Value="True">
                                                <Setter Property="MinHeight" Value="306"/>
                                                <Setter Property="MaxHeight" Value="310"/>
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="10"
                                                                Padding="4">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F5"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                                            </Trigger>
                                                            <!-- 占位项（补齐 3 行布局的空格子）：不可选中/点击，弱化显示 -->
                                                            <DataTrigger Binding="{Binding FullPath}" Value="">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Opacity" Value="0"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <StaticResource ResourceKey="RecentItemTemplate"/>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 空状态提示 -->
                                <Border Background="Transparent"
                                        CornerRadius="8"
                                        Padding="24,20"
                                        Visibility="{Binding RecentItems, Converter={StaticResource CollectionEmptyVisConv}, ConverterParameter=Invert}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔍"
                                                   FontSize="28"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.3"/>
                                        <TextBlock Text="未找到匹配结果"
                                                   FontSize="13"
                                                   Foreground="#9CA3AF"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
