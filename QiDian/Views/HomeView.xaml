<UserControl x:Class="QiDian.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding WelcomeText}"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,12"/>
            <TextBlock Text="这是首页，通过 AutoWire 自动绑定 HomeViewModel"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <Border Background="{DynamicResource SuccessBgBrush}" CornerRadius="8" Padding="16,10">
                <TextBlock Text="{Binding DbStatus}"
                           FontSize="13"
                           Foreground="{DynamicResource SuccessBrush}"
                           HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>