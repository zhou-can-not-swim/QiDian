<Window x:Class="QiDian.NavWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:QiDian.Common"
        mc:Ignorable="d"
        Title="QiDian" Height="680" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <common:ViewModelToViewConverter x:Key="VmToViewConverter"/>

        <!-- 导航按钮样式 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon" Text="{Binding Icon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Width="24"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource NavIconBrush}"/>
                                <TextBlock x:Name="Title" Text="{Binding Title}"
                                           FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="220"/>
            <ColumnDefinition x:Name="DividerColumn" Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Grid x:Name="SideNavGrid" Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo / 标题 -->
            <Border Grid.Row="0" Padding="16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="{DynamicResource PrimaryBrush}" CornerRadius="8">
                        <TextBlock Text="Q" FontSize="18" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="QiDian" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 导航列表 -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="8,8,8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

            <TextBlock Grid.Row="2" Text="QiDian v0.1.0 (ReactiveUI)"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,12"/>
        </Grid>

        <!-- 分割线 -->
        <Rectangle x:Name="NavDivider" Grid.Column="1" Fill="{DynamicResource BorderBrush}"/>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
            <ContentControl Content="{Binding CurrentPage, Converter={StaticResource VmToViewConverter}}" Margin="0"/>
        </Grid>
    </Grid>
</Window>