<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>NU1701</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
		<PackageReference Include="ReactiveUI.Fody" Version="19.5.41" />
		<PackageReference Include="ReactiveUI.WPF" Version="20.4.1" />
		<!-- levelDB数据库 -->
		<PackageReference Include="LevelDB.Standard" Version="2.1.6.1" />
		<!-- 依赖注入 -->
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
	</ItemGroup>

	<!-- 共享契约类库 -->
	<ItemGroup>
		<ProjectReference Include="..\QiDian.Contracts\QiDian.Contracts.csproj" />
		<!-- 内置命令插件（编译期注册，不动态扫描） -->
		<ProjectReference Include="..\QiDian.Plugins\QiDian.Plugins.csproj" />
		<!-- 只保证 F5 时插件先构建并触发 Navs 复制；不复制插件 DLL 到输出根、不产生编译耦合 -->
		<ProjectReference Include="..\QiDian.Nav.Home\QiDian.Nav.Home.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\QiDian.Nav.Settings\QiDian.Nav.Settings.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\QiDian.Nav.Settings\QiDian.Nav.DM.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Everything64.dll：复制到输出目录 -->
	<ItemGroup>
		<Content Include="Everything64.dll" Condition="Exists('Everything64.dll')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="Zhou.LevelDB.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>